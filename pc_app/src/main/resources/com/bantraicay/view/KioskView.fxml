<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1040.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bantraicay.controller.KioskViewController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <VBox spacing="2.0">
                <Label text="MÁY BÁN TRÁI CÂY TỰ ĐỘNG" styleClass="header-title"/>
                <Label text="Khay trái cây tươi mát • Giao diện mua hàng mặc định (Kiosk)" styleClass="header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblEnvironment" text="🌡️ -- °C  |  💧 -- %" styleClass="pill-badge"/>
            <Label fx:id="lblOverheatAlert" text="⚠️ QUÁ NHIỆT (&gt;25°C)" styleClass="pill-danger"
                   visible="false" managed="false"/>
            <Label fx:id="lblConnectionStatus" text="🔌 ESP32: Giả lập" styleClass="pill-badge"/>
            <Label fx:id="lblMachineStatus" text="✅ SẴN SÀNG" styleClass="pill-ready"/>

            <Button fx:id="btnOpenAdmin" text="🔒 Quản trị (Đăng nhập)"
                    onAction="#onOpenAdminLoginClicked" styleClass="btn-admin"/>
        </HBox>
    </top>

    <!-- MAIN KIOSK CONTENT -->
    <center>
        <HBox spacing="22.0" alignment="CENTER">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <!-- LEFT CARD: FRUIT PLATE & QUANTITY -->
            <VBox alignment="CENTER" spacing="14.0" styleClass="card-panel" prefWidth="470.0" HBox.hgrow="ALWAYS">
                <StackPane style="-fx-background-color: #f0fdf4; -fx-background-radius: 16; -fx-padding: 12;">
                    <ImageView fx:id="imgFruitPlate" fitWidth="210.0" fitHeight="210.0" preserveRatio="true"/>
                </StackPane>

                <Label fx:id="lblFruitName" text="Dĩa Trái Cây Tươi Tổng Hợp" styleClass="product-title" wrapText="true"/>
                <Label fx:id="lblUnitPrice" text="25,000 VNĐ / dĩa" styleClass="product-price"/>
                <Label fx:id="lblStockInfo" text="Tồn kho khay: 10 / 15 dĩa" styleClass="stock-label"/>

                <Separator maxWidth="380.0"/>

                <HBox alignment="CENTER" spacing="14.0">
                    <Label text="Số lượng mua:" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Button fx:id="btnDecreaseQty" text="-" onAction="#onDecreaseQtyClicked" styleClass="btn-qty"/>
                    <Label fx:id="lblSelectedQty" text="1" styleClass="qty-value-label"/>
                    <Button fx:id="btnIncreaseQty" text="+" onAction="#onIncreaseQtyClicked" styleClass="btn-qty"/>
                </HBox>

                <Label fx:id="lblTotalAmount" text="Tổng thanh toán: 25,000 VNĐ" styleClass="total-amount-label"/>

                <Button fx:id="btnShowPaymentQr" text="🛒 MUA HÀNG &amp; HIỆN MÃ QR"
                        onAction="#onShowPaymentQrClicked" styleClass="btn-primary" maxWidth="360.0"/>
            </VBox>

            <!-- RIGHT CARD: QR PAYMENT / DISPENSING STATUS -->
            <StackPane styleClass="card-panel" prefWidth="480.0" HBox.hgrow="ALWAYS">

                <!-- STATE 1: IDLE GUIDE -->
                <VBox fx:id="boxIdleGuide" alignment="CENTER" spacing="16.0">
                    <Label text="HƯỚNG DẪN MUA HÀNG NHANH" styleClass="section-heading"/>
                    <VBox spacing="10.0" maxWidth="390.0"
                          style="-fx-background-color: #f8fafc; -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                        <Label text="1. Chọn số lượng dĩa trái cây muốn mua ở bên trái." wrapText="true"
                               style="-fx-font-size: 14px;"/>
                        <Label text="2. Bấm nút 'MUA HÀNG &amp; HIỆN MÃ QR' để tạo giao dịch." wrapText="true"
                               style="-fx-font-size: 14px;"/>
                        <Label text="3. Quét mã QR và bấm 'ĐÃ NHẬN ĐƯỢC TIỀN' để máy tự động đẩy từng dĩa ra hộc nhận hàng." wrapText="true"
                               style="-fx-font-size: 14px;"/>
                    </VBox>
                    <Label fx:id="lblKioskNotice" text="" wrapText="true" visible="false" managed="false"
                           styleClass="pill-danger"/>
                </VBox>

                <!-- STATE 2: QR PAYMENT & MANUAL CONFIRMATION (PAYOS READY) -->
                <VBox fx:id="boxQrPayment" alignment="CENTER" spacing="14.0" visible="false" managed="false">
                    <Label text="THANH TOÁN BẰNG MÃ QR (PAYOS READY)" styleClass="section-heading"/>

                    <StackPane styleClass="qr-frame" maxWidth="228.0" maxHeight="228.0">
                        <ImageView fx:id="imgQrCode" fitWidth="200.0" fitHeight="200.0" preserveRatio="true"/>
                    </StackPane>

                    <Label fx:id="lblQrOrderInfo" text="Mã đơn: ORD-... | Số tiền: 25,000 VNĐ"
                           wrapText="true" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-alignment: CENTER;"/>
                    <Label text="(Chế độ hiện tại: Sau khi kiểm tra chuyển khoản, bấm nút bên dưới để xuất trái cây)"
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-text-alignment: CENTER;"/>

                    <HBox alignment="CENTER" spacing="12.0">
                        <Button fx:id="btnPaymentReceived" text="✅ ĐÃ NHẬN ĐƯỢC TIỀN"
                                onAction="#onPaymentReceivedButtonClicked" styleClass="btn-confirm-money"/>
                        <Button fx:id="btnCancelQr" text="✖ Hủy"
                                onAction="#onCancelQrClicked" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <!-- STATE 3: DISPENSING PROGRESS & RESULT -->
                <VBox fx:id="boxDispenseStatus" alignment="CENTER" spacing="16.0" visible="false" managed="false">
                    <Label fx:id="lblDispenseHeadline" text="ĐANG XUẤT TRÁI CÂY..." styleClass="section-heading"/>
                    <ProgressBar fx:id="progressDispense" prefWidth="340.0" prefHeight="20.0" progress="0.0"/>
                    <Label fx:id="lblDispenseDetail" text="Đã xuất 0/1 dĩa. Vui lòng chờ cảm biến Laser xác nhận..."
                           wrapText="true" style="-fx-font-size: 14px; -fx-text-alignment: CENTER; -fx-padding: 0 16 0 16;"/>
                    <Button fx:id="btnDismissResult" text="Hoàn tất / Giao dịch mới"
                            onAction="#onDismissResultClicked" styleClass="btn-primary" visible="false" managed="false"/>
                </VBox>

            </StackPane>
        </HBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <Label fx:id="lblLastActivity" text="Hệ thống sẵn sàng • CSDL SQLite (WAL) đã khởi tạo."/>
        </HBox>
    </bottom>

</BorderPane>
